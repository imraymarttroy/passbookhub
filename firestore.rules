rules_version = '2';

// PassbookHub: each person can only read and change their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedInAs(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // trust/{owner}: the one person the owner shares their dashboard with (accepted, still in their circle).
    function trustOf(owner) {
      return get(/databases/$(database)/documents/trust/$(owner)).data;
    }
    function trustedBy(owner) {
      return request.auth != null
        && exists(/databases/$(database)/documents/trust/$(owner))
        && trustOf(owner).member == request.auth.uid
        && trustOf(owner).status == 'accepted'
        && exists(/databases/$(database)/documents/profiles/$(owner)/circle/$(request.auth.uid));
    }
    function trustedEditorOf(owner) {
      return trustedBy(owner) && trustOf(owner).role == 'edit';
    }

    // users/{uid}: the profile.
    match /users/{uid} {
      allow read, delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['name', 'birthday', 'username', 'profileDone', 'avatar', 'bio', 'currency', 'createdAt', 'needsMfa', 'address'])
        && (!('needsMfa' in request.resource.data) || request.resource.data.needsMfa is bool)
        && (!('address' in request.resource.data) || request.resource.data.address == null
            || (request.resource.data.address is map
              && request.resource.data.address.keys().hasOnly(['country', 'line1', 'city', 'province', 'postal'])
              && request.resource.data.address.country is string && request.resource.data.address.country.matches('^[A-Z]{2}$')
              && request.resource.data.address.line1 is string && request.resource.data.address.line1.size() <= 120
              && request.resource.data.address.city is string && request.resource.data.address.city.size() <= 60
              && request.resource.data.address.province is string && request.resource.data.address.province.size() <= 60
              && request.resource.data.address.postal is string && request.resource.data.address.postal.size() <= 12))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && (request.resource.data.avatar == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 300000))
        // The username only changes together with claiming usernames/{new name} in the same write.
        && (request.method == 'create' || request.resource.data.username == resource.data.username
            || (request.resource.data.username is string && request.resource.data.username.matches('^[A-Za-z0-9_]{3,20}$')
              && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid));

      // users/{uid}/tx/{id}: income and spending entries. The owner's trusted person may read
      // them, and also add, edit and delete them when the owner chose "Can edit".
      match /tx/{txId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid) || trustedEditorOf(uid);
        allow create, update: if (signedInAs(uid) || trustedEditorOf(uid))
          && request.resource.data.keys().hasOnly(['type', 'desc', 'cents', 'date', 'createdAt', 'category', 'method'])
          && request.resource.data.type in ['income', 'needs', 'wants', 'savings']
          // Optional: a finer category (e.g. Food, Rent) and how it was paid (e.g. Cash, GCash).
          && (!('category' in request.resource.data) || (request.resource.data.category is string && request.resource.data.category.size() <= 40))
          && (!('method' in request.resource.data) || (request.resource.data.method is string && request.resource.data.method.size() <= 40))
          && request.resource.data.desc is string && request.resource.data.desc.size() <= 80
          && request.resource.data.cents is int && request.resource.data.cents > 0
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }

      // users/{uid}/plan/budget: the Budget Plan (your split, salary, custom categories and limits).
      // Only the owner writes it; the trusted person may read it so their view uses the same split.
      match /plan/{planId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && planId == 'budget'
          && request.resource.data.keys().hasOnly(['shares', 'salaryCents', 'cats', 'updatedAt'])
          && request.resource.data.shares is map
          && request.resource.data.shares.keys().hasOnly(['needs', 'wants', 'savings'])
          && request.resource.data.shares.needs is int && request.resource.data.shares.wants is int && request.resource.data.shares.savings is int
          && request.resource.data.shares.needs >= 0 && request.resource.data.shares.wants >= 0 && request.resource.data.shares.savings >= 0
          && request.resource.data.shares.needs + request.resource.data.shares.wants + request.resource.data.shares.savings == 100
          && request.resource.data.salaryCents is int && request.resource.data.salaryCents >= 0 && request.resource.data.salaryCents <= 100000000000000
          && request.resource.data.cats is list && request.resource.data.cats.size() <= 50
          && request.resource.data.updatedAt is int;
      }

      // users/{uid}/accounts/{id}: bank accounts, wallets, credit cards and loans (Savings tracker).
      // Same sharing as entries: the trusted person reads, and writes only with "Can edit".
      match /accounts/{accountId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid) || trustedEditorOf(uid);
        allow create, update: if (signedInAs(uid) || trustedEditorOf(uid))
          && request.resource.data.keys().hasOnly(['bank', 'name', 'type', 'cents', 'last4', 'createdAt', 'updatedAt'])
          && request.resource.data.bank is string && request.resource.data.bank.size() > 0 && request.resource.data.bank.size() <= 40
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.type in ['wallet', 'savings', 'credit', 'loan']
          && request.resource.data.cents is int && request.resource.data.cents >= 0 && request.resource.data.cents <= 100000000000000
          && request.resource.data.last4 is string && request.resource.data.last4.matches('^([0-9]{4})?$')
          && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      }

      // users/{uid}/debts/{id}: personal debts. dir 'owe' = you owe them, 'lent' = they owe you.
      match /debts/{debtId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid) || trustedEditorOf(uid);
        allow create, update: if (signedInAs(uid) || trustedEditorOf(uid))
          && request.resource.data.keys().hasOnly(['dir', 'person', 'note', 'cents', 'paidCents', 'due', 'uid', 'createdAt', 'updatedAt'])
          && (!('uid' in request.resource.data) || (request.resource.data.uid is string
              && request.resource.data.uid.size() > 0 && request.resource.data.uid.size() <= 128 && request.resource.data.uid != uid))
          && request.resource.data.dir in ['owe', 'lent']
          && request.resource.data.person is string && request.resource.data.person.size() > 0 && request.resource.data.person.size() <= 40
          && request.resource.data.note is string && request.resource.data.note.size() <= 80
          && request.resource.data.cents is int && request.resource.data.cents > 0 && request.resource.data.cents <= 100000000000000
          && request.resource.data.paidCents is int && request.resource.data.paidCents >= 0 && request.resource.data.paidCents <= request.resource.data.cents
          && request.resource.data.due is string && request.resource.data.due.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
          && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      }

      // users/{uid}/goals/{id}: savings goals (emergency fund, travel, and so on).
      match /goals/{goalId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid) || trustedEditorOf(uid);
        allow create, update: if (signedInAs(uid) || trustedEditorOf(uid))
          && request.resource.data.keys().hasOnly(['name', 'kind', 'targetCents', 'savedCents', 'due', 'createdAt', 'updatedAt'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.kind in ['emergency', 'family', 'personal', 'education', 'health', 'travel', 'house', 'vehicle', 'gadget', 'wedding', 'business', 'retirement', 'other']
          && request.resource.data.targetCents is int && request.resource.data.targetCents > 0 && request.resource.data.targetCents <= 100000000000000
          && request.resource.data.savedCents is int && request.resource.data.savedCents >= 0 && request.resource.data.savedCents <= 100000000000000
          && request.resource.data.due is string && request.resource.data.due.matches('^([0-9]{4}-[0-9]{2}-[0-9]{2})?$')
          && request.resource.data.createdAt is int && request.resource.data.updatedAt is int;
      }

      // users/{uid}/activity/{id}: history of changes (who added, edited or deleted what).
      // Anyone who can edit the dashboard adds entries as themselves; entries are never changed.
      // Only the owner can clear them.
      match /activity/{entryId} {
        allow read: if signedInAs(uid) || trustedBy(uid);
        allow delete: if signedInAs(uid);
        allow update: if false;
        allow create: if (signedInAs(uid) || trustedEditorOf(uid))
          && request.resource.data.keys().hasOnly(['by', 'action', 'what', 'label', 'sub', 'cents', 'prevCents', 'at'])
          && request.resource.data.by == request.auth.uid
          && request.resource.data.action in ['add', 'edit', 'delete']
          && request.resource.data.what in ['tx', 'goal', 'debt', 'account']
          && request.resource.data.label is string && request.resource.data.label.size() <= 80
          && request.resource.data.sub is string && request.resource.data.sub.size() <= 40
          && request.resource.data.cents is int && request.resource.data.cents >= 0 && request.resource.data.cents <= 100000000000000
          && (!('prevCents' in request.resource.data) || (request.resource.data.prevCents is int
              && request.resource.data.prevCents >= 0 && request.resource.data.prevCents <= 100000000000000))
          && request.resource.data.at is int;
      }
    }

    function signedIn() {
      return request.auth != null;
    }

    match /trust/{owner} {
      function validShare(data) {
        return data.keys().hasOnly(['member', 'role', 'status', 'currency', 'createdAt'])
          && data.member is string && data.member != owner
          && data.role in ['view', 'edit']
          && data.status in ['pending', 'accepted']
          && data.currency is string && data.currency.size() <= 5
          && data.createdAt is int
          && exists(/databases/$(database)/documents/profiles/$(owner)/circle/$(data.member));
      }
      allow read: if signedInAs(owner) || (signedIn() && resource.data.member == request.auth.uid);
      // The owner invites (always "pending") or changes the role or currency. Only the invited person can accept.
      allow create: if signedInAs(owner) && verified() && validShare(request.resource.data)
        && request.resource.data.status == 'pending';
      allow update: if (signedInAs(owner) && validShare(request.resource.data)
          && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'currency'])
            || (request.resource.data.status == 'pending' && verified())))
        || (signedIn() && resource.data.member == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && resource.data.status == 'pending' && request.resource.data.status == 'accepted');
      // The owner removes them, or they decline or leave.
      allow delete: if signedInAs(owner) || (signedIn() && resource.data.member == request.auth.uid);
    }

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // profiles/{uid}: what other PassbookHub members can see. Never budgets, birthdays or emails.
    match /profiles/{uid} {
      allow read: if signedIn();
      allow delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid) && verified()
        && request.resource.data.keys().hasOnly(['name', 'nameLower', 'username', 'usernameLower', 'avatar', 'bio', 'updatedAt', 'education', 'work'])
        && (!('education' in request.resource.data) || (request.resource.data.education is list && request.resource.data.education.size() <= 3))
        && (!('work' in request.resource.data) || (request.resource.data.work is list && request.resource.data.work.size() <= 6))
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.nameLower == request.resource.data.name.lower()
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.usernameLower == request.resource.data.username.lower()
        && request.resource.data.bio is string && request.resource.data.bio.size() <= 160
        && (request.resource.data.avatar == null
            || (request.resource.data.avatar is string && request.resource.data.avatar.size() < 300000));

      // cover/photo: the profile's cover photo, kept apart so lists don't download it.
      match /cover/{docId} {
        allow read: if signedIn();
        allow delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && verified() && docId == 'photo'
          && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
          && request.resource.data.data is string && request.resource.data.data.size() < 450000
          && request.resource.data.updatedAt is int;
      }

      // circleinfo/main: total savings and birthday, only if the owner turned them on. Owner and circle only.
      match /circleinfo/{docId} {
        allow read: if signedInAs(uid) || (signedIn() && inCircle());
        allow delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && docId == 'main'
          && request.resource.data.keys().hasOnly(['showSavings', 'savingsCents', 'currency', 'showBirthday', 'birthday', 'updatedAt'])
          && request.resource.data.showSavings is bool && request.resource.data.showBirthday is bool
          && (request.resource.data.savingsCents == null || (request.resource.data.savingsCents is int && request.resource.data.savingsCents >= 0))
          && (request.resource.data.showSavings || request.resource.data.savingsCents == null)
          && request.resource.data.currency is string && request.resource.data.currency.size() <= 5
          && (request.resource.data.birthday == null || (request.resource.data.birthday is string && request.resource.data.birthday.matches('^[0-9]{2}-[0-9]{2}$')))
          && (request.resource.data.showBirthday || request.resource.data.birthday == null)
          && request.resource.data.updatedAt is int;
      }

      // note/current: a short note above the profile picture. Owner and circle only.
      match /note/{docId} {
        allow read: if signedInAs(uid) || (signedIn() && inCircle());
        allow delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && verified() && docId == 'current'
          && request.resource.data.keys().hasOnly(['text', 'at', 'gif'])
          && request.resource.data.text is string && request.resource.data.text.size() <= 20
          && (!('gif' in request.resource.data) || (request.resource.data.gif is string && request.resource.data.gif.size() < 600000))
          && (request.resource.data.text.size() > 0 || 'gif' in request.resource.data)
          && request.resource.data.at is int;
      }

      function inCircle() {
        return exists(/databases/$(database)/documents/profiles/$(uid)/circle/$(request.auth.uid));
      }

      // Posts: Public, Circle or Only me. A repost or quote is a public post with repostOf: { uid, id }.
      function canSeePost(postId) {
        let p = get(/databases/$(database)/documents/profiles/$(uid)/posts/$(postId)).data;
        return signedIn() && (request.auth.uid == uid
          || p.visibility == 'public'
          || (p.visibility == 'circle' && inCircle()));
      }
      function validRepostOf(data) {
        return !('repostOf' in data) || (
          data.repostOf is map && data.repostOf.keys().hasOnly(['uid', 'id'])
          && data.repostOf.uid is string && data.repostOf.id is string
          && data.visibility == 'public'
          && get(/databases/$(database)/documents/profiles/$(data.repostOf.uid)/posts/$(data.repostOf.id)).data.visibility == 'public');
      }
      match /posts/{postId} {
        allow read: if signedIn() && (request.auth.uid == uid
          || resource.data.visibility == 'public'
          || (resource.data.visibility == 'circle' && inCircle()));
        allow create: if signedInAs(uid) && verified()
          && request.resource.data.keys().hasOnly(['text', 'visibility', 'createdAt', 'repostOf'])
          && request.resource.data.text is string
          && (request.resource.data.text.size() > 0 || 'repostOf' in request.resource.data)
          && request.resource.data.text.size() <= 500
          && request.resource.data.visibility in ['public', 'circle', 'private']
          && request.resource.data.createdAt is int
          && validRepostOf(request.resource.data);
        allow update: if signedInAs(uid) && !('repostOf' in resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility'])
          && request.resource.data.visibility in ['public', 'circle', 'private'];
        allow delete: if signedInAs(uid);

        // likes/{liker}: one like per person.
        match /likes/{liker} {
          allow read: if canSeePost(postId);
          allow create: if signedInAs(liker) && verified() && canSeePost(postId)
            && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at is int;
          allow delete: if signedInAs(liker);
        }

        // replies/{replyId}: anyone who can see the post can reply. The author or the post owner can delete.
        match /replies/{replyId} {
          allow read: if canSeePost(postId);
          allow create: if signedIn() && verified() && canSeePost(postId)
            && request.resource.data.keys().hasOnly(['author', 'text', 'createdAt'])
            && request.resource.data.author == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
            && request.resource.data.createdAt is int;
          allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == resource.data.author);
        }

        // reposts/{reposter}: marks who reposted; postId is the reposter's own repost post.
        match /reposts/{reposter} {
          allow read: if canSeePost(postId);
          allow create: if signedInAs(reposter) && verified()
            && get(/databases/$(database)/documents/profiles/$(uid)/posts/$(postId)).data.visibility == 'public'
            && request.resource.data.keys().hasOnly(['at', 'postId'])
            && request.resource.data.at is int && request.resource.data.postId is string
            && existsAfter(/databases/$(database)/documents/profiles/$(reposter)/posts/$(request.resource.data.postId));
          allow delete: if signedInAs(reposter);
        }
      }

      // circle/{member}: written to both people's lists when a request is accepted.
      match /circle/{member} {
        allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid == member);
        allow create: if verified() && request.resource.data.keys().hasOnly(['since'])
          && ((request.auth.uid == uid && exists(/databases/$(database)/documents/profiles/$(uid)/requests/$(member)))
            || (request.auth.uid == member && exists(/databases/$(database)/documents/profiles/$(member)/requests/$(uid))));
        allow delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == member);
      }

      // requests/{from}: someone asking to join this person's circle. Not allowed if this person blocked them.
      match /requests/{from} {
        allow read, delete: if signedIn() && (request.auth.uid == uid || request.auth.uid == from);
        allow create: if verified() && request.auth.uid == from && from != uid
          && request.resource.data.keys().hasOnly(['createdAt'])
          && !exists(/databases/$(database)/documents/profiles/$(uid)/circle/$(from))
          && !exists(/databases/$(database)/documents/profiles/$(uid)/blocked/$(from));
      }

      // blocked/{other}: people this person blocked. Only they can see their list.
      match /blocked/{other} {
        allow read, delete: if signedInAs(uid);
        allow create, update: if signedInAs(uid) && other != uid
          && request.resource.data.keys().hasOnly(['at', 'name', 'username'])
          && request.resource.data.at is int
          && request.resource.data.name is string && request.resource.data.name.size() <= 60
          && request.resource.data.username is string && request.resource.data.username.size() <= 20;
      }

      // notifications/{id}: only the owner reads them. Others may only leave the kinds below.
      match /notifications/{noteId} {
        // debt: someone in this person's circle tagged them on a debt in their own book.
        // The alert must match that debt (same person, direction and amount).
        function debtNote() {
          let d = request.resource.data;
          let debt = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/debts/$(d.debtId)).data;
          return d.keys().hasOnly(['type', 'from', 'createdAt', 'read', 'debtId', 'dir', 'cents', 'currency'])
            && d.debtId is string && d.debtId.size() > 0 && d.debtId.size() <= 64
            && noteId == 'debt_' + request.auth.uid + '_' + d.debtId
            && d.createdAt is int
            && d.currency is string && d.currency.size() <= 5
            && exists(/databases/$(database)/documents/profiles/$(uid)/circle/$(request.auth.uid))
            && debt.uid == uid && debt.dir == d.dir && debt.cents == d.cents;
        }
        function validNote() {
          return verified()
            && request.resource.data.from == request.auth.uid
            && request.resource.data.read == false
            && ((request.resource.data.type == 'debt' && debtNote())
              || (request.resource.data.keys().hasOnly(['type', 'from', 'createdAt', 'read'])
            && ((request.resource.data.type == 'request' && noteId == 'request_' + request.auth.uid
                  && existsAfter(/databases/$(database)/documents/profiles/$(uid)/requests/$(request.auth.uid)))
              || (request.resource.data.type == 'accepted' && noteId == 'accepted_' + request.auth.uid
                  && existsAfter(/databases/$(database)/documents/profiles/$(uid)/circle/$(request.auth.uid)))
              || (request.resource.data.type == 'trust' && noteId == 'trust_' + request.auth.uid
                  && getAfter(/databases/$(database)/documents/trust/$(request.auth.uid)).data.member == uid)
              || (request.resource.data.type == 'trusted' && noteId == 'trusted_' + request.auth.uid
                  && getAfter(/databases/$(database)/documents/trust/$(uid)).data.member == request.auth.uid
                  && getAfter(/databases/$(database)/documents/trust/$(uid)).data.status == 'accepted'))));
        }
        allow read: if signedInAs(uid);
        allow create: if validNote();
        allow update: if validNote()
          || (signedInAs(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
        allow delete: if signedInAs(uid)
          || (signedIn() && resource.data.from == request.auth.uid && resource.data.type == 'request');
      }
    }

    // "For you" feed: a collection-group query over everyone's public posts.
    match /{path=**}/posts/{postId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
    }

    // presence/{uid}: when someone last had the app open. Readable by them and their circle.
    match /presence/{uid} {
      allow read: if signedInAs(uid)
        || (signedIn() && exists(/databases/$(database)/documents/profiles/$(uid)/circle/$(request.auth.uid)));
      allow delete: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.keys().hasOnly(['at', 'state'])
        && request.resource.data.at is int
        && (!('state' in request.resource.data) || request.resource.data.state in ['online', 'idle', 'dnd']);
    }

    // chats/{a_b}: one conversation between two people in each other's circle.
    // The id is both uids sorted and joined with "_", so membership is readable from the id alone.
    match /chats/{chatId} {
      function pair() {
        return chatId.split('_');
      }
      function isMember() {
        return signedIn() && pair().size() == 2 && request.auth.uid in pair();
      }
      // Circle entries are written to both people's lists, and nobody is in their own circle.
      function circleWithOther() {
        return exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/circle/$(pair()[0]))
          || exists(/databases/$(database)/documents/profiles/$(request.auth.uid)/circle/$(pair()[1]));
      }
      function validSummary(data) {
        return data.lastText is string && data.lastText.size() > 0 && data.lastText.size() <= 140
          && data.lastAt is int && data.seen is map;
      }

      allow get: if isMember();
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if isMember() && verified() && circleWithOther()
        && pair()[0] < pair()[1]
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastFrom', 'lastAt', 'seen', 'delivered'])
        && request.resource.data.members == pair()
        && request.resource.data.lastFrom == request.auth.uid
        && validSummary(request.resource.data)
        && request.resource.data.seen.keys().hasOnly([request.auth.uid])
        && request.resource.data.get('delivered', {}).keys().hasOnly([request.auth.uid]);
      allow update: if isMember()
        && request.resource.data.keys().hasOnly(['members', 'lastText', 'lastFrom', 'lastAt', 'seen', 'delivered'])
        && request.resource.data.members == resource.data.members
        && validSummary(request.resource.data)
        && request.resource.data.seen.diff(resource.data.seen).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.get('delivered', {}).diff(resource.data.get('delivered', {})).affectedKeys().hasOnly([request.auth.uid])
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen', 'delivered'])
          || (request.resource.data.lastFrom == request.auth.uid && verified() && circleWithOther()));
      allow delete: if isMember();

      match /messages/{messageId} {
        // A photo, video or file sent with a message. The bytes live in files/{fileId}_{n}.
        function validAttachment(att) {
          return att is map
            && att.keys().hasOnly(['kind', 'name', 'type', 'size', 'fileId', 'parts', 'thumb'])
            && att.kind in ['photo', 'video', 'file']
            && att.name is string && att.name.size() > 0 && att.name.size() <= 200
            && att.type is string && att.type.size() <= 100
            && att.size is int && att.size > 0 && att.size <= 5242880
            && att.fileId is string && att.fileId.size() <= 40
            && att.parts is int && att.parts > 0 && att.parts <= 8
            && (!('thumb' in att) || (att.thumb is string && att.thumb.size() <= 60000));
        }
        // One reaction per person; you can only set or remove your own.
        function validReactionChange() {
          let before = resource.data.get('reactions', {});
          let after = request.resource.data.reactions;
          return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && after is map
            && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
            && (!(request.auth.uid in after) || (after[request.auth.uid] is string && after[request.auth.uid].size() <= 16));
        }

        allow read: if isMember();
        allow create: if isMember() && verified() && circleWithOther()
          && existsAfter(/databases/$(database)/documents/chats/$(chatId))
          && request.resource.data.keys().hasOnly(['from', 'text', 'createdAt', 'att'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.text.size() > 0 || 'att' in request.resource.data)
          && (!('att' in request.resource.data) || validAttachment(request.resource.data.att))
          && request.resource.data.createdAt is int;
        // The sender may edit the text of their own message (and must stamp editedAt).
        allow update: if isMember() && (
          (resource.data.from == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
            && request.resource.data.editedAt is int)
          || validReactionChange());
        allow delete: if isMember() && resource.data.from == request.auth.uid;
      }

      // files/{fileId}_{n}: base64 chunks of an attachment, written with its message.
      match /files/{chunkId} {
        allow read: if isMember();
        // Kept cheap (no document lookups) so a batch of up to 8 chunks stays within the rules lookup limit.
        allow create: if isMember()
          && request.resource.data.keys().hasOnly(['from', 'n', 'data'])
          && request.resource.data.from == request.auth.uid
          && request.resource.data.n is int && request.resource.data.n >= 0 && request.resource.data.n < 8
          && request.resource.data.data is string && request.resource.data.data.size() <= 900000;
        allow delete: if isMember() && resource.data.from == request.auth.uid;
      }
    }

    // usernames/{lowercase name}: keeps usernames unique. Anyone may check if a name is taken.
    match /usernames/{name} {
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      // The owner may add their sign-in email so they can sign in with the username.
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'email'])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.get('email', '') != ''
        && request.resource.data.email == request.auth.token.email.lower();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // emails/{lowercase email}: lets sign-in say whether an email has an account.
    match /emails/{email} {
      allow get: if true;
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.get('email', '') != ''
        && email == request.auth.token.email.lower();
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }
  }
}
